{
  "name": "@derweili/payload-visual-editing-core",
  "version": "0.1.2",
  "description": "Shared protocol, stega and path helpers for Payload visual editing",
  "keywords": [
    "payload",
    "payloadcms",
    "visual-editing",
    "stega",
    "source-maps"
  ],
  "license": "MIT",
  "author": "Julian Weiland",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/derweili/payload-visual-editing.git",
    "directory": "packages/visual-editing-core"
  },
  "homepage": "https://github.com/derweili/payload-visual-editing/tree/main/packages/visual-editing-core#readme",
  "bugs": "https://github.com/derweili/payload-visual-editing/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "swc ./src -d ./dist --config-file .swcrc --strip-leading-paths --delete-dir-on-start && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@vercel/stega": "1.1.0"
  },
  "devDependencies": {
    "@swc/cli": "0.7.10",
    "@swc/core": "1.15.11",
    "typescript": "5.7.3",
    "vite": "7.3.8",
    "vitest": "4.0.18"
  }
}
