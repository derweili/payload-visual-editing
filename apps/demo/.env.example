# Postgres connection string. Locally: `docker compose up -d` (see docker-compose.yml).
# On Vercel: set by the Neon integration (use the pooled connection string).
DATABASE_URL=postgres://postgres:postgres@localhost:54329/demo

# Random string, at least 32 characters: `openssl rand -hex 32`
PAYLOAD_SECRET=change-me-to-a-long-random-string

# Optional. Public origin of the site, e.g. https://demo.example.com.
# Falls back to VERCEL_PROJECT_PRODUCTION_URL on Vercel and http://localhost:3000 locally.
NEXT_PUBLIC_SERVER_URL=

# Optional locally. Set by the Vercel Blob integration; without it, uploads go to ./media.
BLOB_READ_WRITE_TOKEN=

# The admin user that `pnpm seed` creates (only if it doesn't exist yet)
SEED_ADMIN_EMAIL=demo@example.com
SEED_ADMIN_PASSWORD=change-me
