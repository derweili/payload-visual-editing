{
  "name": "payload-visual-editing",
  "private": true,
  "description": "Visual editing for Payload 3: click content in the preview, edit the field in the admin",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" --if-present build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --if-present test",
    "test:e2e": "pnpm --filter @derweili/payload-visual-editing-dev test:e2e",
    "pack:check": "pnpm --filter @derweili/payload-visual-editing-dev pack:check",
    "dev": "pnpm --filter @derweili/payload-visual-editing-dev dev",
    "dev:demo": "pnpm --filter @derweili/payload-visual-editing-demo dev",
    "docs:dev": "pnpm --filter @derweili/payload-visual-editing-docs dev",
    "docs:build": "pnpm --filter @derweili/payload-visual-editing-docs build",
    "docs:preview": "pnpm --filter @derweili/payload-visual-editing-docs preview",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "2.29.8"
  },
  "engines": {
    "node": "^22.23.5 || ^24.22.3 || >=26.13.1",
    "pnpm": "^9 || ^10 || ^11"
  },
  "packageManager": "pnpm@11.28.13"
}
